# ==============================================================================
# TestCraft AI Backend Configuration Template
# ==============================================================================
# Instructions for external developers / contributors:
# 1. Copy this file and rename it to `.env` inside the `backend/` directory.
# 2. Add your own free Groq API Key from: https://console.groq.com/keys
# 3. Never commit your personal `.env` file to version control.
# ==============================================================================

# Server Default Groq API Key (Obtain free at https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# JWT Secret Key for authenticating sessions & password hashing
JWT_SECRET_KEY=generate_a_secure_random_secret_key_here

# Optional: Persistent Database URL (e.g. Supabase, Neon, PostgreSQL). If omitted, SQLite is used.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
